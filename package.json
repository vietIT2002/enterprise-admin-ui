{
  "name": "enterprise-admin-ui-dev",
  "private": true,
  "description": "Tests and development tools for the enterprise-admin-ui Agent Skill. The skill itself is skills/enterprise-admin-ui/.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\"",
    "test:ci": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./tests/github-reporter.mjs --test-reporter-destination=stdout \"tests/*.test.mjs\"",
    "audit": "node skills/enterprise-admin-ui/scripts/audit-cli.mjs",
    "build:adapters": "node tools/build-adapters.mjs",
    "check:adapters": "node tools/build-adapters.mjs --check",
    "check:next": "node tools/check-next-build.mjs"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  }
}
